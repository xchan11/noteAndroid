<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/main_grey_bg">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/item_toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="24dp">

        <TextView
            android:id="@+id/tvOldPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="旧密码"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etOldPwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingEnd="48dp"
            app:layout_constraintTop_toBottomOf="@id/tvOldPwd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvNewPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="新密码"
            app:layout_constraintTop_toBottomOf="@id/etOldPwd"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etNewPwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingEnd="48dp"
            app:layout_constraintTop_toBottomOf="@id/tvNewPwd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvConfirmPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="确认新密码"
            app:layout_constraintTop_toBottomOf="@id/etNewPwd"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etConfirmPwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingEnd="48dp"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPwd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivOldPwdToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="显示/隐藏旧密码"
            android:src="@drawable/ic_eye"
            app:layout_constraintBottom_toBottomOf="@id/etOldPwd"
            app:layout_constraintEnd_toEndOf="@id/etOldPwd"
            app:layout_constraintTop_toTopOf="@id/etOldPwd" />

        <ImageView
            android:id="@+id/ivNewPwdToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="显示/隐藏新密码"
            android:src="@drawable/ic_eye"
            app:layout_constraintBottom_toBottomOf="@id/etNewPwd"
            app:layout_constraintEnd_toEndOf="@id/etNewPwd"
            app:layout_constraintTop_toTopOf="@id/etNewPwd" />

        <ImageView
            android:id="@+id/ivConfirmPwdToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="显示/隐藏确认新密码"
            android:src="@drawable/ic_eye"
            app:layout_constraintBottom_toBottomOf="@id/etConfirmPwd"
            app:layout_constraintEnd_toEndOf="@id/etConfirmPwd"
            app:layout_constraintTop_toTopOf="@id/etConfirmPwd" />

        <Button
            android:id="@+id/btnUpdatePwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="修改密码"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPwd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>

