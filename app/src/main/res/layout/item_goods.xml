<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_corner"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvGoodsName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="物品名称"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivArrow"
        app:layout_constraintHorizontal_bias="0" />

    <TextView
        android:id="@+id/tvShelfInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="保质期：yyyy-MM-dd / 无保质期"
        android:textColor="#666666"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvGoodsName"
        app:layout_constraintStart_toStartOf="@id/tvGoodsName"
        app:layout_constraintEnd_toStartOf="@id/tvStatus"
        app:layout_constraintHorizontal_bias="0" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="未过期"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:background="@drawable/shape_priority_blue"
        app:layout_constraintTop_toTopOf="@id/ivArrow"
        app:layout_constraintEnd_toStartOf="@id/ivArrow" />

    <TextView
        android:id="@+id/tvTraceInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="放置位置：xxx"
        android:textColor="#999999"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvShelfInfo"
        app:layout_constraintStart_toStartOf="@id/tvGoodsName"
        app:layout_constraintEnd_toStartOf="@id/ivArrow"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/arrow_right_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

