<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/main_grey_bg">

        <!-- 顶部预算展示栏（可点击） -->
        <LinearLayout
            android:id="@+id/layoutBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月预算"
                android:textSize="12sp"
                android:textColor="#666666" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvBudgetAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalSpend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已支出：0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRemainAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="剩余：0"
                    android:textSize="14sp"
                    android:textColor="#52C41A" />
            </LinearLayout>
        </LinearLayout>

        <!-- 快速记账按钮 -->
        <TextView
            android:id="@+id/tvQuickAdd"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#1890FF"
            android:gravity="center"
            android:text="快速记账"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- 本月收支概览 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本月收支概览"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMonthIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收入：0"
                android:textSize="13sp"
                android:textColor="#52C41A" />

            <TextView
                android:id="@+id/tvMonthExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="支出：0"
                android:textSize="13sp"
                android:textColor="#F5222D" />

            <TextView
                android:id="@+id/tvToChart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="查看图表"
                android:textSize="13sp"
                android:textColor="#1890FF" />
        </LinearLayout>

        <!-- 最近收支流水 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="最近收支"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tvEmptyBill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="暂无收支记录"
                android:textColor="#999999"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</layout>
